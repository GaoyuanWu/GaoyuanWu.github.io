@article{wu2026bayes,
  abbr = {ES},
  title={Shape Optimization of Box-Type Structures under Waves using Multi-objective {Bayesian Optimization}: Reducing Wave Loads and Improving Wave Attenuation},
  author={Wu, Gaoyuan and Smith, Sam and Garlock, Maria},
  journal={Engineering Structures},
  volume={360},
  year={2026},
  month={August},
  doi             = {10.1016/j.engstruct.2026.122780},
  preview         = {Multi_press_visualization.png},
  selected        = {true},
  abstract  = {Box-type coastal structures—including breakwaters and box-girder bridges—face growing threats from intensifying coastal hazards, where structural shape critically influences wave–structure interaction. Existing shape optimization frameworks are limited by simplified wave theory and single-objective formulations. This work proposes a novel methodology coupling Smoothed Particle Hydrodynamics (SPH) with Multi-Objective Bayesian Optimization (MOBO) to optimize the shape of box-type coastal infrastructure under realistic wave loads. In a single-objective problem, the optimal design improves wave attenuation by 60% over a conventional rectangular breakwater. In the multi-objective setting, a Pareto-optimal set of designs is identified that simultaneously reduces wave forces and improves wave attenuation—all outperforming the traditional rectangular design. A parallelization scheme further reduces computational time by 73%.},
}

